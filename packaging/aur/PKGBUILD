# Maintainer: XaoticLabs
# AUR scaffold (grimoire-agent-daemon: the `grimoire` name is taken on
# crates.io; AUR availability should be checked before first publish).
# Builds from the release source tarball. Update pkgver + checksums per
# release; `updpkgsums` fills sha256sums.
pkgname=grimoire-agent-daemon
pkgver=0.1.0
pkgrel=1
pkgdesc="cron + systemd for AI coding agents — bring your own CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/XaoticLabs/grimoire"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'git')
makedepends=('rust' 'protobuf')
optdepends=('bubblewrap: filesystem sandboxing for agents'
            'systemd: cgroup resource limits for agents')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "grimoire-$pkgver"
  cargo build --release --locked --bins
}

package() {
  cd "grimoire-$pkgver"
  install -Dm755 target/release/grim "$pkgdir/usr/bin/grim"
  install -Dm755 target/release/grimw "$pkgdir/usr/bin/grimw"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  ./target/release/grim completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/grim"
  ./target/release/grim completions zsh  | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_grim"
  ./target/release/grim completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/grim.fish"
}
